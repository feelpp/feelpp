    "validation-traction-x": {
      "description": "Pure traction case from validation.pdf: clamp XMoins and apply a total 1 N load on XPlus.",
      "geometry": {
        "kind": "rectangular",
        "template": "$top_srcdir/feelpp/quickstart/meshes/sb9_rectangular_shell.geo.tmpl",
        "length": 1.0,
        "width": 1.0,
        "thickness": 1.0,
        "nx": 1,
        "ny": 1,
        "nz": 1
      },
      "material": {
        "E": 1.0,
        "nu": 0.45
      },
      "boundaryConditions": {
        "clampMarkers": [ "XMoins" ]
      },
      "loads": {
        "bodyForce": "{0,0,0}",
        "totalForces": [
          {
            "marker": "XPlus",
            "value": [ 1.0, 0.0, 0.0 ]
          }
        ]
      },
      "probe": {
        "point": [ 1.0, 0.5, 0.5 ],
        "direction": [ 1.0, 0.0, 0.0 ],
        "label": "tip x displacement"
      },
      "reference": {
        "probeValue": 1.0,
        "absoluteTolerance": 1.0e-12,
        "relativeTolerance": 1.0e-12,
        "description": "Exact axial elongation FL/(EA) from validation.pdf setup"
