circle-dirichlet --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-dirichlet.cfg --checker.tolerance.exact=5e-14 --directory=qs_laplacian/circle-dirichlet
runtime-p4-g1 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-dirichlet.cfg --order=4 --geometry.order=1 --gmsh.hsize=0.4 --checker.tolerance.exact=1e-10 --checker.filename=${CMAKE_CURRENT_SOURCE_DIR}/cases/runtime-order-checker.json --checker.script=${CMAKE_CURRENT_SOURCE_DIR}/python/laplacian.py --directory=qs_laplacian/runtime-p4-g1
runtime-p4-g1-robin --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-robin.cfg --order=4 --geometry.order=1 --gmsh.hsize=0.4 --checker.tolerance.exact=1e-10 --checker.filename=${CMAKE_CURRENT_SOURCE_DIR}/cases/runtime-order-checker.json --checker.script=${CMAKE_CURRENT_SOURCE_DIR}/python/laplacian.py --directory=qs_laplacian/runtime-p4-g1-robin
runtime-p2-g2 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-dirichlet.cfg --order=2 --geometry.order=2 --gmsh.hsize=0.4 --checker.solution=x+y --functions.g=x+y:x:y --functions.f=0 --checker.tolerance.exact=1e-10 --checker.filename=${CMAKE_CURRENT_SOURCE_DIR}/cases/runtime-order-checker.json --checker.script=${CMAKE_CURRENT_SOURCE_DIR}/python/laplacian.py --directory=qs_laplacian/runtime-p2-g2
runtime-p3-g3 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-dirichlet.cfg --order=3 --geometry.order=3 --gmsh.hsize=0.4 --checker.solution=x+y --functions.g=x+y:x:y --functions.f=0 --checker.tolerance.exact=1e-10 --checker.filename=${CMAKE_CURRENT_SOURCE_DIR}/cases/runtime-order-checker.json --checker.script=${CMAKE_CURRENT_SOURCE_DIR}/python/laplacian.py --directory=qs_laplacian/runtime-p3-g3
# comment out neumann, need to implement handling of solution up to a constant
# circle-neumann --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-neumann.cfg --checker.tolerance.exact=5e-14
circle-robin --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-robin.cfg --checker.tolerance.exact=5e-14 --directory=qs_laplacian/circle-robin
circle-all --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/circle/circle-all.cfg --checker.tolerance.exact=5e-14 --directory=qs_laplacian/circle-all
triangle-oneelt-1 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/triangle/triangle.cfg --gmsh.hsize=4 --functions.g=1 --checker.solution=1 --functions.c=0 --directory=qs_laplacian/triangle-oneelt-1
triangle-oneelt-x+y --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/triangle/triangle.cfg --gmsh.hsize=4 --functions.g=x+y:x:y --checker.solution=x+y --functions.c=-1 --directory=qs_laplacian/triangle-oneelt-x+y
triangle-oneelt-x2+y2 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/triangle/triangle.cfg --gmsh.hsize=4 --functions.g=x^2+y^2:x:y --checker.solution=x*x+y*y  --functions.f=-4 --functions.c=-2*y:y --directory=qs_laplacian/triangle-oneelt-x2+y2
triangle-1 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/triangle/triangle.cfg  --functions.g=1 --checker.solution=1 --functions.c=0 --directory=qs_laplacian/triangle-1
triangle-x-plus-y --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/triangle/triangle.cfg   --functions.g=x+y:x:y --checker.solution=x+y --functions.c=-1 --directory=qs_laplacian/triangle-x+y
triangle-x2-plus-y2 --config-file ${CMAKE_CURRENT_SOURCE_DIR}/cases/triangle/triangle.cfg --functions.g=x^2+y^2:x:y --checker.solution=x*x+y*y --functions.f=-4 --functions.c=-2*y:y --directory=qs_laplacian/triangle-x2+y2
