{
  "name": "validation-moment-y",
  "description": "Moment case from validation.pdf page 10: clamp YMoins and apply a unit resultant moment on YPlus through an equivalent tangential traction field.",
  "gmsh": {
    "filename": "validation_moment_y.geo"
  },
  "material": {
    "E": 10.0,
    "nu": 0.0
  },
  "boundaryConditions": {
    "clampMarkers": [
      "YMoins"
    ]
  },
  "loads": {
    "bodyForce": "{0,0,0}",
    "tractions": [
      {
        "marker": "YPlus",
        "expr": "{6*z,0,-6*(x-0.5)}:x:y:z"
      }
    ]
  },
  "probe": {
    "point": [
      1.0,
      1.0,
      0.5
    ],
    "direction": [
      0.0,
      0.0,
      1.0
    ],
    "label": "diagnostic z displacement"
  },
  "checks": {
    "target": "hexa8",
    "items": [
      {
        "type": "elasticity-point-fields",
        "name": "validation-pdf-page-10-center",
        "point": [
          0.5,
          0.5,
          0.0
        ],
        "references": {
          "hexa8": {
            "epsilon": [
              1.03e-18,
              -1.388e-17,
              1.388e-17,
              -6.94e-18,
              6.94e-18,
              5.551e-17
            ],
            "sigma": [
              1.03e-17,
              -1.388e-16,
              1.388e-16,
              -3.47e-17,
              3.47e-17,
              2.776e-16
            ]
          },
          "sb9g25": {
            "epsilon": [
              -1.5e-19,
              -1.388e-17,
              1.388e-17,
              0.0,
              0.0,
              0.0
            ],
            "sigma": [
              -1.5e-18,
              -1.388e-16,
              1.388e-16,
              0.0,
              0.0,
              0.0
            ]
          }
        },
        "description": "PDF Epsilon/Sigma values are displayed with MATLAB scale factors; component order xx,yy,zz,xy,xz,yz.",
        "tolerance": {
          "absolute": 5e-13
        }
      }
    ]
  }
}
