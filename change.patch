+++ b/.github/workflows/coding-standards.yml
@@ -0,0 +1,129 @@
+name: coding-standards
+
+on:
+  pull_request:
+  merge_group:
+
+permissions:
+  contents: read
+
+jobs:
+  clang-format-check:
+    name: clang-format (diff only)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Install clang-format
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y clang-format-17
+      - name: Collect changed files
+        id: files
+        shell: bash
+        run: |
+          if [ "${{ github.event_name }}" = "pull_request" ]; then
+            BASE="${{ github.event.pull_request.base.sha }}"
+          else
+            BASE="${{ github.event.before }}"
+          fi
+          git fetch origin "$BASE" --depth=1 || true
+          FILES=$(git diff --diff-filter=AM --name-only "$BASE" HEAD -- '*.c' '*.cc' '*.cxx' '*.cpp' '*.h' '*.hh' '*.hpp')
+          FILTERED=""
+          for file in $FILES; do
+            if [[ "$file" =~ ^third_party/ ]] || [[ "$file" =~ ^external/ ]]; then
+              continue
+            fi
+            FILTERED+="$file\n"
+          done
+          if [ -z "$FILTERED" ]; then
+            echo "files=" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          echo -e "$FILTERED" | sed '/^$/d' > changed-files.txt
+          cat changed-files.txt
+          printf 'files=%s\n' "$(paste -sd ' ' changed-files.txt)" >> "$GITHUB_OUTPUT"
+      - name: Run clang-format diff
+        if: steps.files.outputs.files != ''
+        run: |
+          while read -r file; do
+            clang-format-17 --style=file "$file" | diff -u "$file" - || (
+              echo "clang-format suggested changes in $file" && exit 1
+            )
+          done < changed-files.txt
+      - name: No C/C++ changes detected
+        if: steps.files.outputs.files == ''
+        run: echo "No C/C++ files changed; skipping clang-format check."
+
+  clang-tidy:
+    name: clang-tidy (diff only)
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Install clang-tidy
+        run: |
+          sudo apt-get update
+          sudo apt-get install -y clang-tidy-17
+      - name: Collect changed files
+        id: files
+        shell: bash
+        run: |
+          if [ "${{ github.event_name }}" = "pull_request" ]; then
+            BASE="${{ github.event.pull_request.base.sha }}"
+          else
+            BASE="${{ github.event.before }}"
+          fi
+          git fetch origin "$BASE" --depth=1 || true
+          FILES=$(git diff --diff-filter=AM --name-only "$BASE" HEAD -- '*.c' '*.cc' '*.cxx' '*.cpp' '*.h' '*.hh' '*.hpp')
+          FILTERED=""
+          for file in $FILES; do
+            if [[ "$file" =~ ^third_party/ ]] || [[ "$file" =~ ^external/ ]]; then
+              continue
+            fi
+            FILTERED+="$file\n"
+          done
+          if [ -z "$FILTERED" ]; then
+            echo "files=" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          echo -e "$FILTERED" | sed '/^$/d' > changed-files.txt
+          cat changed-files.txt
+          printf 'files=%s\n' "$(paste -sd ' ' changed-files.txt)" >> "$GITHUB_OUTPUT"
+      - name: Generate compile commands
+        if: steps.files.outputs.files != ''
+        shell: bash
+        run: |
+          mkdir -p build/clang-tidy
+          echo '[' > build/clang-tidy/compile_commands.json
+          first=1
+          while read -r file; do
+            if [ $first -eq 0 ]; then
+              echo ',' >> build/clang-tidy/compile_commands.json
+            fi
+            first=0
+            cat <<JSON >> build/clang-tidy/compile_commands.json
+  {
+    "directory": "${GITHUB_WORKSPACE}",
+    "command": "clang++ -std=c++20 -I${GITHUB_WORKSPACE} -I${GITHUB_WORKSPACE}/feelpp -I${GITHUB_WORKSPACE}/toolboxes -I${GITHUB_WORKSPACE}/testsuite -c ${file}",
+    "file": "${file}"
+  }
+JSON
+          done < changed-files.txt
+          echo ']' >> build/clang-tidy/compile_commands.json
+          cat build/clang-tidy/compile_commands.json
+      - name: Run clang-tidy
+        if: steps.files.outputs.files != ''
+        run: |
+          while read -r file; do
+            clang-tidy-17 "$file" \
+              --quiet \
+              --config-file=.clang-tidy \
+              -p build/clang-tidy || exit 1
+          done < changed-files.txt
+      - name: No C/C++ changes detected
+        if: steps.files.outputs.files == ''
+        run: echo "No C/C++ files changed; skipping clang-tidy."
+
