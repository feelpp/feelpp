{
    "Name": "cylinder under gravity-testcase",
    "ShortName":"cug",
    "Parameters":
    {
        "hfar":0.1,
        "hclose_wall1":0.05,
        "hclose_wall2":0.01,
        "d2r_bounded_wall1":"min(meshes_fluid_distanceToRange_wall1_normalized_min_max,0.2)/0.2:meshes_fluid_distanceToRange_wall1_normalized_min_max",
        "mymetric_wall1":"hclose_wall1+(hfar-hclose_wall1)*d2r_bounded_wall1:hclose_wall1:hfar:d2r_bounded_wall1",
        "d2r_bounded_wall2":"min(meshes_fluid_distanceToRange_wall2_normalized_min_max,0.2)/0.2:meshes_fluid_distanceToRange_wall2_normalized_min_max",
        "mymetric_wall2":"hclose_wall2+(hfar-hclose_wall2)*d2r_bounded_wall2:hclose_wall2:hfar:d2r_bounded_wall2"
    },
    "Meshes":
    {
        "fluid":
        {
            "Import":
            {
                "filename":"$cfgdir/cylinder_under_gravity.geo",
                "hsize":0.01
            },
            "Partitioning":{
                "splitting":[ "Fluid", "CylinderVolume" ],
                "constraints":{
                    "no_interprocess_faces":["CylinderSurface"]
                }
            },
            "MeshMotion":
            {
                "ComputationalDomain":
                {
                    "markers":"Fluid",
                    "method":"harmonic_extension"
                },
                "Displacement":
                {
                    "Zero":["Walls","Top","Bottom"]
                }
            },
            "MeshAdaptation":[
                {
                    "metric":"min(mymetric_wall1,mymetric_wall2):mymetric_wall1:mymetric_wall2",
                    "required_markers":["CylinderVolume"],
                    "events":{
                        "after_import":{},
                        //"after_init":{}
                        "each_time_step":{
                            "frequency":4 //15
                        }
                    }
                }],
            "DistanceToRange":
            {
                "wall1":
                {
                    "markers":["Walls","Top","Bottom"],
                    "normalization":"min_max"
                },
                "wall2":
                {
                    "markers":["CylinderSurface"],
                    "normalization":"min_max"
                }
            }
        }
    },
    "Models":
    {
        "fluid":
        {
            "materials":"Fluid",
            "setup":
            {
                "equations":"Navier-Stokes",
                //"gravity":1
                "gravity":
                {
                    "enable":1,
                    "expr":"{0,-980}"
                }
            }
        },
        "multibody":{
            "name":"mbody",
            "setup":{
                "bodies":[
                    {
                        "name":"body0",
                        "materials":["MySolid"]
                    }]
            }
        }
    },
    "Materials":
    {
        "Fluid":{
            "markers":"Fluid",
            "rho":"1",
            "mu":"0.01"
        },
        "MySolid":{
            "markers":"CylinderVolume",
            "rho":"1.5"
        }
    },
    "BoundaryConditions":
    {
        "velocity":
        {
            "Dirichlet":
            {
                "Walls":
                {
                    "expr":"{0,0}"
                },
                "Bottom":
                {
                    "expr":"{0,0}"
                }
            }
        },
        "fluid":
        {
            "outlet":
            {
                "Top":
                {
                    //"expr":"0"
                }
            },
            "body":
            {
                "body0":
                 {
                     "markers":"CylinderSurface"
                }
            }
        }
    },
    "PostProcess":
    {
        "fluid":
        {
            "Exports":
            {
                "fields":["velocity","pressure","pid","mesh-displacement"]
            },
            "Measures":
            {
                "Quantities":
                {
                    "names":"all"
                }
            }
        }
    }
}
