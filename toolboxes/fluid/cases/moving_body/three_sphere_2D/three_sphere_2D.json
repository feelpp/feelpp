{
    "Name": "three_sphere_2D swimmer",
    "ShortName":"three_sphere_2D swimmer",
    "Models":
    {
        "fluid":
        {
            "materials":"Fluid",
            "setup":{
                "equations":"Stokes"
            }
        },
        "multibody":{
            "name":"toto",
            "setup":{
                "bodies":[
                    {
                        "name":"CircleLeft",
                        "materials":["CirLeft"]
                    },
                    {
                        "name":"CircleCenter",
                        "materials":["CirCenter"]
                    },
                    {
                        "name":"CircleRight",
                        "materials":["CirRight"]
                    }
                ],
                "connectors":{},
                "constraints":{}
            }
        }
    },
    "Meshes":
    {
        "fluid":
        {
            "Import":
            {
                "filename":"$cfgdir/three_sphere_2D.geo",
                //"filename":"$cfgdir/ring.geo",
                "hsize":3
            },
            "Partitioning":{
                "splitting":[ "Fluid", ["CirLeft","CirCenter","CirRight"] ],
                "constraints":{
                    "no_interprocess_faces":["CircleCenter","CircleRight","CircleLeft"]
                }
            },
            "MeshMotion":
            {
                "ComputationalDomain":
                {
                    "markers":"Fluid",
                    "method":"harmonic_extension"
                },
                "Displacement":
                {
                    "Zero":["BoxWalls"]
                }
            },
            "MeshAdaptation":[
                {
                    "metric":"min(mymetric_wall1,mymetric_wall2):mymetric_wall1:mymetric_wall2",
                    "required_markers":["CirLeft","CirCenter","CirRight"],
                    "events":{
                        "after_import":{},
                        //"after_init":{}
                        "each_time_step":{
                            "frequency":1//4 //15
                        }
                    }
                }],
            "DistanceToRange":
            {
                "wall1":
                {
                    "markers":["BoxWalls"],
                    "normalization":"min_max"
                },
                "wall2":
                {
                    "markers":["CircleLeft","CircleCenter","CircleRight"],
                    "normalization":"min_max"
                }
            }


        }
    },
    "Materials":
    {
        "Fluid":{
            "rho":"1",
            "mu":"1"
        },
        "CirLeft":{
            "rho":1e-1//"1e-3"
        },
        "CirCenter":{
            "rho":1e-1//"1e-3"
        },
        "CirRight":{
            "rho":1e-1//"1e-3"
        }
    },
    "Parameters":
    {
        "eps":1e-10,

        "hfar":3,
        "hclose_wall1":1,
        "hclose_wall2":0.1,//0.3,
        "d2r_bounded_wall1":"min(meshes_fluid_distanceToRange_wall1_normalized_min_max,0.2)/0.2:meshes_fluid_distanceToRange_wall1_normalized_min_max",
        "mymetric_wall1":"hclose_wall1+(hfar-hclose_wall1)*d2r_bounded_wall1:hclose_wall1:hfar:d2r_bounded_wall1",
        "d2r_bounded_wall2":"min(meshes_fluid_distanceToRange_wall2_normalized_min_max,0.2)/0.2:meshes_fluid_distanceToRange_wall2_normalized_min_max",
        "mymetric_wall2":"hclose_wall2+(hfar-hclose_wall2)*d2r_bounded_wall2:hclose_wall2:hfar:d2r_bounded_wall2"
    },
    "BoundaryConditions":
    {
        "fluid":
        {
            "velocity":
            {
                "BoxWalls":
                {
                    "expr":"{0,0}"
                }
            },
            "body":
            {
                "CircleCenter":
                {
                    "markers":["CircleCenter"]
                },
                "CircleRight":
                {
                    "markers":["CircleRight"],
                    "articulation":
                    {
                        "body":"CircleCenter",
                        //"translational-velocity":"4*pulse(t,1,2,4)-4*pulse(t,3,4,4):t"
                        //"translational-velocity":"4*pulse(t,1-eps,2-eps,4)-4*pulse(t,3-eps,4-eps,4):t:eps"
                        "translational-velocity":"1.5*4*pulse(t,1-eps,2-eps,4)-1.5*4*pulse(t,3-eps,4-eps,4):t:eps"
                    }
                },
                "CircleLeft":
                {
                    "markers":["CircleLeft"],
                    "articulation":
                    {
                        "body":"CircleCenter",
                        //"translational-velocity":"4*pulse(t,0,1,4)-4*pulse(t,2,3,4):t"
                        //"translational-velocity":"4*(pulse(t,0,1-eps,4)+pulse(t,4-eps,4,4)) -4*pulse(t,2-eps,3-eps,4):t:eps"
                        "translational-velocity":"1.5*4*(pulse(t,0,1-eps,4)+pulse(t,4-eps,4,4)) -1.5*4*pulse(t,2-eps,3-eps,4):t:eps"

                    }
                }
            }
        }
    },
    "PostProcess":
    {
        "fluid":
        {
            "Exports":
            {
                "fields":["velocity","pressure","pid","mesh-displacement"]
            },
            "Measures":
            {
                //"Forces":"CircleCenter"
                "Quantities":
                {
                    "names":"all"//"body_SphereLeft.fluid_forces"// ["body_SphereLeft.mass_center","body_SphereCenter.mass_center","body_SphereRight.mass_center"]
                    // "expr":
                    // {
                    //     "mc_Left":"{body_SphereLeft_mass_center_0,body_SphereLeft_mass_center_1,body_SphereLeft_mass_center_2}:body_SphereLeft_mass_center_0:body_SphereLeft_mass_center_1:body_SphereLeft_mass_center_2",
                    //     "mc_Center":"{body_SphereCenter_mass_center_0,body_SphereCenter_mass_center_1,body_SphereCenter_mass_center_2}:body_SphereCenter_mass_center_0:body_SphereCenter_mass_center_1:body_SphereCenter_mass_center_2",
                    //     "mc_Right":"{body_SphereRight_mass_center_0,body_SphereRight_mass_center_1,body_SphereRight_mass_center_2}:body_SphereRight_mass_center_0:body_SphereRight_mass_center_1:body_SphereRight_mass_center_2"
                    // }
                }
            }
        }
    }

}

