{
    "Name": "Magneto head",
    "ShortName":"Magneto head",
    "Models":
    {
        "fluid":
        {
            "materials":"Fluid",
            "equations":"Stokes"
        },
        "body":
        {
            "materials":["head"]
        }
    },
    "Parameters":
    {
        "theta":0,
        "vel":0,
        "hfar":0.2,
        "hclose_wall1":"0.02",
        "d2r_bounded_wall1":"min(meshes_fluid_distanceToRange_wall1_normalized_min_max,0.2)/0.2:meshes_fluid_distanceToRange_wall1_normalized_min_max",
        "mymetric_wall1":"hclose_wall1+(hfar-hclose_wall1)*d2r_bounded_wall1:hclose_wall1:hfar:d2r_bounded_wall1"
    },
    "Meshes":
    {
        "fluid":
        {
            "Import":
            {
                "filename":"/nvme0/vanlandeghem/feelpp-test/toolboxes/fluid/cases/head.geo",
                "hsize":0.02
            },
            "MeshMotion":
            {
                "ComputationalDomain":
                {
                    "markers":["Fluid"]
                },
                "Displacement":
                {
                    "Zero":["BoxWalls"]
                }
            },
            "DistanceToRange":
            {
                "wall1":
                {
                    "markers":"boundary_head",
                    "normalization":"min_max"
                }

            },
            "MeshAdaptation":[
                {
                    "metric":"mymetric_wall1:mymetric_wall1",
                    "events":{
                        "after_import":{},
                        "after_init":{}
                    }
                },
                {
                    "metric":"mymetric_wall1:mymetric_wall1",
                    "events":{
                        "each_time_step":{
                            "frequency":5
                        }
                    }
                }]
        }
    },
    "Materials":
    {
        "Fluid":{
            "markers":"Fluid",
            "rho":"1",
            "mu":"1000"
        },
        "head":{
            "markers":"head",
            "rho":"7"
        }
    },
    "BoundaryConditions":
    {
        "fluid":
        {
            "velocity":
            {
                "BoxWalls":
                {
                    "expr":"{0,0}"
                }
            },

            "body":
            {
                "boundary_head":
                {
                    "markers":"boundary_head",
                    "materials":
                    {
                        "names":["head"]
                    },
                    "translational-velocity":"{vel*cos(theta),vel*sin(theta)}:theta:vel"
                }
            }
        }
    },
    "MagnetoTorque":  
    {
        "body":
        {
            "setup": 
            {
                "torqueParam":
                {
                    "trajectory":"cos",
                    "mx":10000,
                    "my":10000,
                    "mz":1,
                    "bx":1000, 
                    "by":1000,
                    "bz":1
                }
            }
        }
    },
    "PostProcess":
    {
        "fluid":{
            "Exports":
            {
                "fields":["velocity","pressure","pid","mesh-displacement"],
                "expr":
                {
                    "Re":"meshes_fluid_fields_Re:meshes_fluid_fields_Re"
                }

            },
            "Measures":
            {
                "Quantities":
                {
                    "names":"all"
                }
            }
        }
       
    }

}