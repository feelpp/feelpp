// -*- mode: javascript -*-
{
    "Name":"cvg2d",
    "ShortName":"cvg2d",
    "Parameters":
    {
        "v_expr":"2*0.25/Pi*atan2(x,y):x:y",
        "c_expr":"{-2*0.25/Pi*y/(x*x+y*y),2*0.25/Pi*x/(x*x+y*y)}:x:y:z",
        "grad_v_expr":"{0.5/Pi*y/(x*x+y*y),-0.5/Pi*x/(x*x+y*y)}:x:y"
    },
    "Meshes":
    {
        "electric":
        {
            "Import":
            {
                "filename":"$cfgdir/2d.geo",
                "hsize":0.1
            }
        }
    },
    "Materials":
    {
        "omega":
        {
            "sigma":"4.8e7"
        }
    },
    "BoundaryConditions":
    {
        "electric":
        {
            "electric_potential":
            {
                "V0":
                {
                    "expr":"0" // V_in
                },
                "V1":
                {
                    "expr":"0.25" // V_out
                }
            }
        }
    },
    "PostProcess":
    {
        "electric":
        {
            "Exports":
            {
                "fields":["electric-potential","electric-field","pid"]
            },
            "Measures":
            {
                "Norm":
                {
                    "error-evaluated":
                    {
                        "field":"electric-potential",
                        "type":["L2-error","H1-error"],
                        "solution":"v_expr:v_expr",
                        "grad_solution":"{0.5/Pi*y/(x*x+y*y),-0.5/Pi*x/(x*x+y*y)}:x:y"
                    }
                }
            },
            "Checkers":
            {
                "Measures":
                {
                    "Norm_error-evaluated_L2-error":
                    {
                        "value":0,
                        "tolerance":1e-2
                    },
                    "Norm_error-evaluated_H1-error":
                    {
                        "value":0,
                        "tolerance":1
                    }
                }
            }
        }
    }
}
