// -*- mode: javascript -*-
{
    "Name":"electric-convergence-square-2d",
    "ShortName":"conv-square-2d",
    "Parameters":
    {
        "v_expr":"exp(x)*cos(y):x:y",
        "grad_v_expr":"{exp(x)*cos(y),-exp(x)*sin(y)}:x:y"
    },
    "Meshes":
    {
        "electric":
        {
            "Import":
            {
                "filename":"$cfgdir/2d.geo",
                "hsize":0.1
            }
        }
    },
    "Materials":
    {
        "omega":
        {
            "sigma":"1"
        }
    },
    "BoundaryConditions":
    {
        "electric":
        {
            "electric_potential":
            {
                "Vexact":
                {
                    "expr":"v_expr:v_expr",
                    "markers":["Vexact"]
                }
            }
        }
    },
    "PostProcess":
    {
        "electric":
        {
            "Exports":
            {
                "fields":["electric-potential","electric-field","pid"]
            },
            "Measures":
            {
                "Norm":
                {
                    "error-evaluated":
                    {
                        "field":"electric-potential",
                        "type":["L2-error","H1-error"],
                        "solution":"v_expr:v_expr",
                        "grad_solution":"{exp(x)*cos(y),-exp(x)*sin(y)}:x:y",
                        "quad":15,
                        "quad1":15
                    }
                }
            },
            "Checkers":
            {
                "Measures":
                {
                    "Norm_error-evaluated_L2-error":
                    {
                        "value":0,
                        "tolerance":1e-2
                    },
                    "Norm_error-evaluated_H1-error":
                    {
                        "value":0,
                        "tolerance":1e-1
                    }
                }
            }
        }
    }
}
