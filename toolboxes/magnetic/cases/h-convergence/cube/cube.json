// -*- mode: javascript -*-
{
    "Name": "magnetostatic_cube_h-conv",
    "ShortName":"magnetostatic_cube_h-conv",
    "Models":
    {
        "magnetic":
        {
            //"materials":["Omega"],
            "setup": {
                "current_density-sources":{
                    "expr":"{(4-2*y^2-2*z^2)/(mu_0*mu_r), (4-2*x^2-2*z^2)/(mu_0*mu_r), (4-2*x^2-2*y^2)/(mu_0*mu_r)}:x:y:z:mu_0:mu_r"
                }
            }
        }
    },
    "Meshes":
    {
        "magnetic":
        {
            "Import":
            {
                "filename":"$cfgdir/cube.geo",
                "hsize":0.1
            },
            "Fields":
            {
                "solution_exact":{
                    "basis":"Pchv2",
                    "expr":"{(1-y^2)*(1-z^2),(1-x^2)*(1-z^2),(1-x^2)*(1-y^2)}:x:y:z"
                }
            }
        }
    },
    "Parameters":
    {
        "mu_0":"physics_magnetic_magnetic_mu_0:physics_magnetic_magnetic_mu_0",
        "mu_r":"materials_Omega_mu_r:materials_Omega_mu_r",
        "solution_exact":"{(1-y^2)*(1-z^2),(1-x^2)*(1-z^2),(1-x^2)*(1-y^2)}:x:y:z",
        "solution_exact_discr":"{meshes_magnetic_fields_solution_exact_0,meshes_magnetic_fields_solution_exact_1,meshes_magnetic_fields_solution_exact_2}:meshes_magnetic_fields_solution_exact_0:meshes_magnetic_fields_solution_exact_1:meshes_magnetic_fields_solution_exact_2"
    },
    "Materials":
    {
        "Omega":
        {
            "mu_r":1.25663706127e6
        }
    },
    "BoundaryConditions":
    {
        "magnetic":
        {
            "magnetic_potential_imposed":
            {
                "boundary":
                {
                    "markers":["Boundary"],
                    //"expr":"{0,0,0}"
                    "expr":"{solution_exact_0,solution_exact_1,solution_exact_2}:solution_exact_0:solution_exact_1:solution_exact_2"
                }
            }
        }
    },
    "PostProcess":
    {
        "magnetic":
        {
            "Exports":
            {
                "fields":["vector_potential","flux-density","pid"],
                "expr": {
                    "solution_exact":"{solution_exact_0,solution_exact_1,solution_exact_2}:solution_exact_0:solution_exact_1:solution_exact_2",
                    "vector_potential":{
                        "expr":"{magnetic_A_0,magnetic_A_1,magnetic_A_2}:magnetic_A_0:magnetic_A_1:magnetic_A_2",
                        "representation":"element"
                    },
                    "mu_0":"mu_0:mu_0",
                    "mu_r":"mu_r:mu_r",
                    "materials_Omega_mu_r":"materials_Omega_mu_r:materials_Omega_mu_r",
                    "physics_magnetic_vacuum_mu_0":"physics_magnetic_magnetic_mu_0:physics_magnetic_magnetic_mu_0"
                }
            },
            "Measures":
            {
                "Norm":
                {
                    "error-evaluated":
                    {
                        "field":"vector_potential",
                        "type":["L2-error"],
                        "solution":"{solution_exact_0,solution_exact_1,solution_exact_2}:solution_exact_0:solution_exact_1:solution_exact_2"
                    }
                }
            }
        }
    }
}
