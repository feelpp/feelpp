// -*- mode: javascript -*-
{
    "Name": "magnetostatic_h-conv",
    "ShortName":"magnetostatic_h-conv",
    "Models":
    {
        "magnetic":
        {
            //"name":"toto",
            //"materials":["mymat1","mymat2"],
            "setup": {
                //"current_density":"{2/materials_mu,2/materials_mu}:materials_mu"
                "current_density-sources":{
                    "expr":"{2/1e-3,2/1e-3}"
                }
            }
        }
    },

    // "Models":
    // {
    // //     "cfpdes":{
    // //         "equations":"magneto"
    // //     },
    //     "magneto":{
    //         "setup":{
    //             "unknown":{
    //                 "basis":"Ned1h0",
    //                 "name":"potential",
    //                 "symbol":"A"
    //             },
    //             "coefficients":{
    //                 "zeta":"1/materials_mu:materials_mu",
    //                 "a":"1",
    //                 "f":"{2/materials_mu,2/materials_mu}:materials_mu"
    //             }
    //         }
    //     }
