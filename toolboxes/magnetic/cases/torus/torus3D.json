// -*- mode: javascript -*-
{
    "Name": "magnetostatic_torus3D",
    "ShortName":"magnetostatic_torus3D",
    "Models":
    {
        "magnetic":
        [{
            "name":"Coil",
            "materials":["Coil"],
            "setup": {
                "current_density-sources":{
                    "expr":"{meshes_magnetic_fields_J_proj_0,meshes_magnetic_fields_J_proj_1,meshes_magnetic_fields_J_proj_2}:meshes_magnetic_fields_J_proj_0:meshes_magnetic_fields_J_proj_1:meshes_magnetic_fields_J_proj_2"
                }
            }
        },
        {
            "name":"Omega",
            "materials":["Omega"],
            "setup": {}
        }]
    },
    "Meshes":
    {
        "magnetic":
        {
            "Import":
            {
                "filename":"$cfgdir/torus3D.geo",
                "hsize":0.01 // 0.01, 0.005, 0.0025
            },
            "Fields":
            {
                "J_proj":{
                    "basis":"Pchv2",//"Ned1h0",//"Pchv2",
                    "expr":"{-2000000*y/sqrt(x^2+y^2),2000000*x/sqrt(x^2+y^2),0}:x:y:z"
                }
            }
        }
    },
    "Parameters":
    {
        "mu_0":"physics_magnetic_Coil_mu_0:physics_magnetic_Coil_mu_0"
    },
    "Materials":
    {
        "Omega":
        {
            "mu_r":"1"
        },
        "Coil":
        {
            "mu_r":"1"
        }
    },
    "BoundaryConditions":
    {
        "magnetic":
        {
            "magnetic_potential_imposed":
            {
                "boundary":
                {
                    "markers":["BoundaryInfinite"],
                    "expr":"{0,0,0}"
                }
            }
        }
    },
    "PostProcess":
    {
        "magnetic":
        {
            "Exports":
            {
                "fields":["vector_potential","flux-density","field-intensity","pid"],
                "expr": {
                    "vector_potential":{
                        "expr":"{magnetic_A_0,magnetic_A_1,magnetic_A_2}:magnetic_A_0:magnetic_A_1:magnetic_A_2",
                        "representation":"element"
                    }
                }
            },
            "Measures":
            {
                "Points":
                {
                    "pointCenter":
                    {
                        "coord":"{0,0,0}",
                        "expressions":
                        {
                            "Bz":"magnetic_B_2:magnetic_B_2",
                            "Hz":"magnetic_H_2:magnetic_H_2"
                        }
                    },
                    "vertical_segment":
                    {
                        "over_geometry":
                        {
                            "segment":
                            {
                                "point1":"{0,0,1}",
                                "point2":"{0,0,-1}",
                                "n_points":100
                            }
                        },
                        "expressions":
                        {
                            "Bz":"magnetic_B_2:magnetic_B_2",
                            "Hz":"magnetic_H_2:magnetic_H_2"
                        },
                        "include_coordinates":1,
                        "output":
                        {
                            "type":"table"
                            //"name":"vertical_centerline"
                        }
                    }

                }
            }
        }
    }
}
