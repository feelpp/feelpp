{
   "name": "Feel++ Ubuntu Noble (24.04)",
   "image": "ghcr.io/feelpp/feelpp-env:ubuntu-24.04",
   "workspaceFolder": "/workspaces/feelpp-7",
   "remoteUser": "feelpp",
   "updateRemoteUserUID": true,
   "init": true,
   "containerEnv": {
      "FEELPP_CMAKE_PRESET": "container-ubuntu-noble",
      "DISTRIBUTION": "-ubuntu-24.04"
   },
   "remoteEnv": {
      "CMAKE_BUILD_PARALLEL_LEVEL": "25"
   },
   "postCreateCommand": "${containerWorkspaceFolder}/.devcontainer/feelppconfig.sh ${containerWorkspaceFolder}",
   "customizations": {
      "vscode": {
         "settings": {
            "cmake.configurePreset": "container-ubuntu-noble",
            "cmake.buildPreset": "container-ubuntu-noble"
         },
         "extensions": [
            "ms-vscode.cpptools",
            "ms-vscode.cmake-tools",
            "josetr.cmake-language-support-vscode",
            "asciidoctor.asciidoctor-vscode",
            "ms-python.python",
            "ms-toolsai.jupyter",
            "ms-vsliveshare.vsliveshare",
            "shardulm94.trailing-spaces",
            "redhat.vscode-yaml"
         ]
      }
   }
}
