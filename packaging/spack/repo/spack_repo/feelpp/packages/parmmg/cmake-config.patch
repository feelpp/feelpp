+# Export the existing targets through a discoverable, relocatable package.
+file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/ParMmgConfig.cmake"
+  "include(CMakeFindDependencyMacro)\nfind_dependency(mmg CONFIG)\ninclude(\"\${CMAKE_CURRENT_LIST_DIR}/ParMmgTargets.cmake\")\n")
